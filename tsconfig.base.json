{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "preserveSymlinks": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "dsh-factory-protocol": ["packages/protocol/src/index.ts"],
      "dsh-factory-protocol/types": ["packages/protocol/src/types.ts"],
      "dsh-factory-store": ["packages/store/src/index.ts"],
      "dsh-factory-store-sqlite": ["packages/store-sqlite/src/index.ts"],
      "dsh-factory-domain": ["packages/domain/src/index.ts"],
      "dsh-factory-tools": ["packages/tools/src/index.ts"],
      "dsh-factory-scheduler": ["packages/scheduler/src/index.ts"]
    },
    "experimentalDecorators": false
  }
}
