{
  "name": "dsh-factory",
  "version": "0.1.8",
  "description": "Durable dependency-graph task factory for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "bun@1.4.0",
  "files": [
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-factory-client-ui": "workspace:^",
    "dsh-factory-domain": "workspace:^",
    "dsh-factory-protocol": "workspace:^",
    "dsh-factory-scheduler": "workspace:^",
    "dsh-factory-store": "workspace:^",
    "dsh-factory-store-sqlite": "workspace:^",
    "dsh-factory-tools": "workspace:^"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "bun run build && tsc -b tsconfig.host.json tsconfig.client.json --pretty false && tsc -p tsconfig.e2e.json --pretty false",
    "build": "bun run clean && bun run --filter dsh-factory-protocol build && bun run --filter dsh-factory-store build && bun run --filter dsh-factory-store-sqlite build && bun run --filter dsh-factory-tools build && bun run --filter dsh-factory-domain build && bun run --filter dsh-factory-scheduler build && bun run --filter dsh-factory-client-ui build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:packed-install": "node scripts/verify-packed-install.mjs",
    "install:local": "node scripts/install-local.mjs",
    "check": "bun run typecheck && bun run test && bun run verify:packed-install",
    "link:harness": "node scripts/link-harness.mjs"
  },
  "devDependencies": {
    "@monotykamary/dsh-typert-generator": "^0.1.0-rc.11",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "lucide-react": "1.31.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/dsh-factory.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ]
}
