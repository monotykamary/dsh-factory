{
  "name": "dsh-factory-store",
  "version": "0.1.6",
  "description": "Factory persistence Service Definition",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "dependencies": {
    "dsh-factory-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@monotykamary/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@monotykamary/dsh-typert-generator": "^0.1.0-rc.11",
    "@monotykamary/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/dsh-factory.git",
    "directory": "packages/store"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false"
  }
}
